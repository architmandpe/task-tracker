DATABASE_URL=postgresql+psycopg://tracker:tracker@db:5432/tracker
JWT_SECRET=change-me-to-a-long-random-string
INTERNAL_SECRET=

# Google sign-in (optional). Leave blank and the app just doesn't offer the
# button. Create an OAuth 2.0 Client ID of type "Web application" at
# https://console.cloud.google.com/apis/credentials and register
# http://localhost:5173/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set this when developing against the Vite dev server (port 5173): Vite's proxy
# rewrites the Host header, so the API would otherwise derive a :8000 callback
# while your browser sits on :5173.
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
