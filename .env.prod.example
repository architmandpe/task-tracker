# Copy to .env.prod on the server and fill in real values.
# Used by: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# Your DuckDNS (or other) domain, pointed at the VM's IP - Caddy issues a real
# HTTPS cert for it automatically.
DOMAIN=your-app.duckdns.org

# Generate fresh values for production - do not reuse your local dev secrets.
JWT_SECRET=
INTERNAL_SECRET=

# Any values you choose - these are the passwords for the two self-hosted
# Postgres containers (task-tracker's and copilot's pgvector one).
TRACKER_POSTGRES_PASSWORD=
COPILOT_POSTGRES_PASSWORD=

# Same provider keys copilot already uses locally.
GROQ_API_KEY=
GEMINI_API_KEY=
